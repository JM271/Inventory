rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function membership() {
      return get(/databases/$(database)/documents/workshops/molenstraat/members/$(request.auth.uid)).data;
    }
    function member() {
      return signedIn() && membership().role in ['admin', 'editor'];
    }
    function admin() { return signedIn() && membership().role == 'admin'; }
    function validPart(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'sku', 'imageAsset', 'location', 'quantity', 'minimum', 'carQuantity', 'carMinimum', 'garageQuantity', 'garageMinimum'])
        && data.keys().hasOnly(['productNumber', 'orderNumber', 'id', 'name', 'category', 'sku', 'imageAsset', 'location', 'quantity', 'minimum', 'carQuantity', 'carMinimum', 'garageQuantity', 'garageMinimum'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 512
        && data.name is string && data.name.size() > 0 && data.name.size() <= 500
        && data.category is string && data.category.size() <= 100
        && (!('orderNumber' in data) || (data.orderNumber is string && data.orderNumber.size() <= 200))
        && (!('productNumber' in data) || (data.productNumber is string && data.productNumber.size() <= 200))
        && data.sku is string && data.sku.size() <= 200
        && data.imageAsset is string && data.imageAsset.size() <= 500
        && data.location is string && data.location.size() <= 500
        && data.quantity is int && data.quantity >= 0
        && data.minimum is int && data.minimum >= 0
        && data.carQuantity is int && data.carQuantity >= 0
        && data.carMinimum is int && data.carMinimum >= 0
        && data.garageQuantity is int && data.garageQuantity >= 0
        && data.garageMinimum is int && data.garageMinimum >= 0;
    }
    // --- Molenstraat Angebote (repair offers app) ---
    function text(value, max) { return value is string && value.size() <= max; }
    function validOffer(id, data) {
      return data.keys().hasOnly(['id', 'number', 'createdAt', 'validUntil', 'status', 'customerName', 'customerPhone', 'customerEmail', 'bikeModel', 'frameNumber', 'problem', 'notes', 'lines', 'updatedAt', 'updatedBy'])
        && data.keys().hasAll(['id', 'number', 'createdAt', 'validUntil', 'status', 'lines', 'updatedAt', 'updatedBy'])
        && data.id == id
        && data.number is string && data.number.matches('A-[0-9]{4}-[0-9]{3,6}')
        && text(data.createdAt, 40) && text(data.validUntil, 40)
        && data.status in ['draft', 'sent', 'accepted', 'declined']
        && text(data.get('customerName', ''), 200) && text(data.get('customerPhone', ''), 100)
        && text(data.get('customerEmail', ''), 200) && text(data.get('bikeModel', ''), 200)
        && text(data.get('frameNumber', ''), 100) && text(data.get('problem', ''), 5000)
        && text(data.get('notes', ''), 5000)
        && data.lines is list && data.lines.size() <= 200
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }
    function validOfferSettings(data) {
      return data.keys().hasOnly(['companyName', 'address', 'phone', 'email', 'hourlyRateCents', 'vatRate', 'pricesIncludeVat', 'validityDays', 'currency', 'footer'])
        && text(data.get('companyName', ''), 200) && text(data.get('address', ''), 1000)
        && text(data.get('phone', ''), 100) && text(data.get('email', ''), 200)
        && data.get('hourlyRateCents', 0) is int && data.get('hourlyRateCents', 0) >= 0
        && data.get('vatRate', 0) is number && data.get('vatRate', 0) >= 0 && data.get('vatRate', 0) <= 100
        && data.get('pricesIncludeVat', true) is bool
        && data.get('validityDays', 30) is int && data.get('validityDays', 30) >= 0
        && text(data.get('currency', ''), 10) && text(data.get('footer', ''), 2000);
    }
    // --- Shared product catalogue (Spoke and offers app) ---
    function validProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'category'])
        && data.keys().hasOnly(['sku', 'name', 'category', 'supplierSku', 'imageAsset', 'priceCents'])
        && text(data.sku, 200) && data.sku.size() > 0
        && text(data.name, 500) && data.name.size() > 0
        && text(data.category, 100)
        && text(data.get('supplierSku', ''), 200)
        && text(data.get('imageAsset', ''), 500)
        && data.get('priceCents', 0) is int && data.get('priceCents', 0) >= 0;
    }
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }
    match /workshops/molenstraat {
      allow read: if member();
      // Only the initial-import marker lives here. It can never be reset.
      allow create, update: if member()
        && request.resource.data.keys().hasOnly(['initialized'])
        && request.resource.data.initialized == true;
      allow delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || admin());
        allow list: if admin();
        allow create, update: if admin() && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'editor'];
        allow delete: if admin() && uid != request.auth.uid;
      }
      match /parts/{partId} {
        allow read: if member();
        allow create: if member() && validPart(request.resource.data)
          && getAfter(/databases/$(database)/documents/workshops/molenstraat).data.initialized == true;
        allow update: if member() && validPart(request.resource.data)
          && request.resource.data.id == resource.data.id;
        allow delete: if member();
      }
      match /stockChanges/{changeId} {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['partId', 'name', 'productNumber', 'action', 'beforeWorkshop', 'afterWorkshop', 'beforeCar', 'afterCar', 'beforeGarage', 'afterGarage', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.partId is string
          && request.resource.data.name is string
          && request.resource.data.productNumber is string
          && request.resource.data.action in ['Added', 'Edited', 'Adjusted', 'Transferred', 'Deleted', 'Imported']
          && request.resource.data.beforeWorkshop is int && request.resource.data.beforeWorkshop >= 0
          && request.resource.data.afterWorkshop is int && request.resource.data.afterWorkshop >= 0
          && request.resource.data.beforeCar is int && request.resource.data.beforeCar >= 0
          && request.resource.data.afterCar is int && request.resource.data.afterCar >= 0
          && request.resource.data.get('beforeGarage', 0) is int && request.resource.data.get('beforeGarage', 0) >= 0
          && request.resource.data.get('afterGarage', 0) is int && request.resource.data.get('afterGarage', 0) >= 0;
        allow update, delete: if false;
      }
      match /catalog/{sku} {
        allow read: if member();
        allow create: if member() && validPart(request.resource.data)
          && request.resource.data.sku.size() > 0;
        allow update, delete: if false;
      }
      // Offers, their settings and price list are shared by all members.
      match /offers/{offerId} {
        allow read: if member();
        allow create, update: if member() && validOffer(offerId, request.resource.data);
        allow delete: if member();
      }
      // Offer numbers per year (A-2026-001 …) only ever increase.
      match /offerCounters/{year} {
        allow read: if member();
        allow create: if member() && year.matches('20[0-9]{2}')
          && request.resource.data.keys().hasOnly(['last'])
          && request.resource.data.last is int && request.resource.data.last >= 1;
        allow update: if member()
          && request.resource.data.keys().hasOnly(['last'])
          && request.resource.data.last is int
          && request.resource.data.last >= resource.data.last;
        allow delete: if false;
      }
      match /offerConfig/settings {
        allow read: if member();
        allow create, update: if member() && validOfferSettings(request.resource.data);
        allow delete: if false;
      }
      match /offerConfig/presets {
        allow read: if member();
        allow create, update: if member()
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list && request.resource.data.items.size() <= 500;
        allow delete: if false;
      }
      // The shared product catalogue. The SKU is stored in upper case and
      // its encoded form is the document ID, so a SKU exists only once.
      match /products/{productId} {
        allow read: if member();
        allow create, update: if member() && validProduct(request.resource.data);
        allow delete: if admin();
      }
      // Set once when the catalogue was first filled from the bundled list.
      match /catalogConfig/state {
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['seeded'])
          && request.resource.data.seeded == true;
        allow update, delete: if false;
      }
      // Own sales price per catalogue SKU, overriding the catalogue price.
      match /partPrices/{key} {
        allow read: if member();
        allow create, update: if member()
          && request.resource.data.keys().hasOnly(['sku', 'priceCents'])
          && text(request.resource.data.sku, 200) && request.resource.data.sku.size() > 0
          && request.resource.data.priceCents is int && request.resource.data.priceCents > 0;
        allow delete: if member();
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
